{
  "name": "mosa-albayati-portfolio",
  "private": true,
  "description": "Static portfolio for Mosa Albayati — HTML, Tailwind CSS, jQuery.",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/assets/css/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/assets/css/styles.css --watch",
    "serve": "npx serve public"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
